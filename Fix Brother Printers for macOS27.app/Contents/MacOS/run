#!/bin/bash

# ---------------------------------------------------------------
# Fix Brother Printers for macOS27
# Прави автоматично стъпки 1-3 от ръчната инструкция за Rosetta 2.
# Стъпка 4 (преинсталация на Brother driver-а) остава на потребителя,
# но приложението отваря директно страницата за сваляне.
# ---------------------------------------------------------------

show_dialog() {
    # $1 = съобщение, $2 = бутони (списък през запетая), връща избрания бутон
    osascript -e "display dialog \"$1\" buttons {$2} default button (count of {$2}) with title \"Fix Brother Printers for macOS27\" with icon note" \
        -e "button returned of result" 2>/dev/null
}

# --- Проверка дали Rosetta вече е инсталирана ---
if /usr/bin/pgrep oahd >/dev/null 2>&1; then
    ALREADY_CHOICE=$(show_dialog "Rosetta 2 вече е инсталирана на този Mac. Можеш директно да пробваш да инсталираш Brother driver-а." "\"Затвори\",\"Отвори страницата на Brother\"")
    if [ "$ALREADY_CHOICE" = "Отвори страницата на Brother" ]; then
        open "https://support.brother.com/g/b/producttop.aspx?c=eu_ot&lang=en" 2>/dev/null
    fi
    exit 0
fi

# --- Стъпка 1-2: обяснение + инсталация на Rosetta ---
ANSWER=$(show_dialog "Ще инсталираме Rosetta 2 — нужна е, за да работят стари Brother driver-и на новия macOS.\\n\\nСега ще се появи прозорец, който пита за администраторската ти парола (тази, с която влизаш в Mac-а)." "\"Отказ\",\"Инсталирай\"")

if [ "$ANSWER" != "Инсталирай" ]; then
    exit 0
fi

osascript -e 'do shell script "softwareupdate --install-rosetta --agree-to-license" with administrator privileges' 2>/tmp/fixbrother_err.log
INSTALL_STATUS=$?

if [ $INSTALL_STATUS -ne 0 ]; then
    ERR=$(cat /tmp/fixbrother_err.log)
    osascript -e "display dialog \"Инсталацията не мина: $ERR\\n\\nОпитай пак или инсталирай ръчно през Terminal:\\nsoftwareupdate --install-rosetta\" buttons {\"Затвори\"} with icon caution with title \"Fix Brother Printers for macOS27\""
    exit 1
fi

# --- Стъпка 3: рестарт ---
RESTART_CHOICE=$(show_dialog "Rosetta 2 е инсталирана успешно.\\n\\nСега Mac-ът трябва да се РЕСТАРТИРА, за да проработи. Затвори важните си файлове преди това." "\"Ще рестартирам сам по-късно\",\"Рестартирай сега\"")

if [ "$RESTART_CHOICE" = "Рестартирай сега" ]; then
    osascript -e 'tell application "System Events" to restart'
    exit 0
fi

# --- Стъпка 4: указание + линк към Brother ---
FINAL_CHOICE=$(show_dialog "Не забравяй: след рестарта пробвай пак да инсталираш оригиналния Brother driver (версията за по-стара macOS) — вече трябва да се задвижи." "\"Затвори\",\"Отвори страницата на Brother\"")

if [ "$FINAL_CHOICE" = "Отвори страницата на Brother" ]; then
    open "https://support.brother.com/g/b/producttop.aspx?c=eu_ot&lang=en" 2>/dev/null
fi
